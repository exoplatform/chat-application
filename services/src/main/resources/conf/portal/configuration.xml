<configuration 
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.exoplatform.org/xml/ns/kernel_1_3.xsd http://www.exoplatform.org/xml/ns/kernel_1_3.xsd"
  xmlns="http://www.exoplatform.org/xml/ns/kernel_1_3.xsd">

    <component profiles="ecms">
        <type>org.exoplatform.chat.service.DocumentService</type>
        <init-params>
          <value-param>
            <name>upload.limit</name>
            <value>${exo.chat.upload.limit:100}</value>
          </value-param>
        </init-params>
    </component>

    <component>
        <type>org.exoplatform.addons.chat.notification.pwa.ChatMessagePwaNotificationPlugin</type>
    </component>
    <component>
        <type>org.exoplatform.addons.chat.notification.pwa.ChatMentionPwaNotificationPlugin</type>
    </component>

    <component>
        <type>org.exoplatform.addons.chat.notification.plugin.ChatRoomPermalinkPlugin</type>
    </component>

    <external-component-plugins>
        <target-component>org.exoplatform.services.resources.ResourceBundleService</target-component>
        <component-plugin>
        <name>Commons UI Component Resource Bundle</name>
        <set-method>addResourceBundle</set-method>
        <type>org.exoplatform.services.resources.impl.BaseResourceBundlePlugin</type>
        <init-params>
            <values-param>
            <name>classpath.resources</name>
            <description>The resources that start with the following package name should be load from file system</description>
            <value>locale.portlet.chat.Resource</value>          
            </values-param>
            <values-param>
            <name>portal.resource.names</name>
            <description>The properties files of the portal , those file will be merged into one ResoruceBundle properties </description>
            <value>locale.portlet.chat.Resource</value>
            </values-param>
        </init-params>
        </component-plugin>
    </external-component-plugins>
    <external-component-plugins>
        <target-component>org.exoplatform.commons.upgrade.UpgradeProductService</target-component>
        <component-plugin  profiles="chat">
            <name>ChatSpacesAdministratorsUpgradePlugin-2</name>
            <set-method>addUpgradePlugin</set-method>
            <type>org.exoplatform.addons.chat.upgrade.ChatSpacesAdministratorsUpgradePlugin</type>
            <description>Check and fix administrators space room</description>
            <init-params>
                <value-param>
                    <name>product.group.id</name>
                    <description>The groupId of the product</description>
                    <value>org.exoplatform.platform</value>
                </value-param>
                <value-param>
                    <name>plugin.upgrade.target.version</name>
                    <description>The plugin target version of selected groupId</description>
                    <value>7.0.0</value>
                </value-param>
                <value-param>
                    <name>plugin.execution.order</name>
                    <description>The plugin execution order</description>
                    <value>10</value>
                </value-param>
                <value-param>
                    <name>plugin.upgrade.execute.once</name>
                    <description>The plugin must be executed only once</description>
                    <value>true</value>
                </value-param>
                <value-param>
                    <name>plugin.upgrade.async.execution</name>
                    <description>The plugin will be executed in an asynchronous mode</description>
                    <value>true</value>
                </value-param>
            </init-params>
        </component-plugin>
    </external-component-plugins>
</configuration>
